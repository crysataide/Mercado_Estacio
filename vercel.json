{
    "builds": [
        {
            "src": "**/*.php",
            "use": "@vercel/php"
        },
        {
            "src": "Styles/**",
            "use": "@vercel/static"
        },
        {
            "src": "Imagens/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}